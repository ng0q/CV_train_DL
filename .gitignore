# Virtual environment
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Environment and secrets
.env
.env.*
*.key
kaggle.json

# OS / IDE
.DS_Store
.vscode/
.idea/
*.swp

# Data (large datasets — keep folder via .gitkeep)
data/*
!data/.gitkeep

# Model weights (keep folder via .gitkeep).
# model/model.pth is stored with Git LFS, so it is not ignored.
model/*
!model/.gitkeep
*.pt
*.pth
*.ckpt
*.onnx
!model/model.pth
